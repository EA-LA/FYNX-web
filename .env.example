# Server only. Copy required values into an ignored .env file. Never add keys to browser assets.
# Local Node22+ startup: node --env-file=.env scripts/quant-dev-server.cjs
QUANT_PORT=4174
QUANT_HOST=127.0.0.1
# A persistent private volume, outside the web root, is recommended in production.
QUANT_DATA_DIR=.quant-data
QUANT_MIN_FREE_BYTES=3221225472
# Streamed stored-tick backtests/grids can take longer than small browser research.
QUANT_HISTORY_JOB_TIMEOUT_MS=3600000
# Twelve Data /quote API; market coverage, quotas and redistribution rights depend on subscription.
QUANT_QUOTES_API_KEY=
# Conservative per-process rolling 60-second request budget; tune to provider entitlement.
QUANT_QUOTES_PER_MINUTE=8
# Trading Economics API credentials including historical economic-calendar entitlement.
QUANT_CALENDAR_API_KEY=
# Firebase ID tokens are verified server-side against this project; ADC grants revoked-token checks.
QUANT_FIREBASE_PROJECT_ID=
# Optional service-account file path, outside the web root; prefer workload identity in production.
GOOGLE_APPLICATION_CREDENTIALS=
# Exact origins only. Same-origin reverse proxy is preferred.
QUANT_ALLOWED_ORIGINS=https://fynxfinanceworld.com,https://www.fynxfinanceworld.com,http://127.0.0.1:4174,http://localhost:4174
# Nightly ingestion uses only completed UTC days, serial requests, bounded storage.
QUANT_NIGHTLY_SYMBOLS=EURUSD,XAUUSD
QUANT_NIGHTLY_TIMEFRAMES=D1,M1
QUANT_NIGHTLY_MAX_BYTES=536870912
# Reserved optional capabilities. This build uses deterministic parsing and no remote broker access.
QUANT_LLM_PARSER_ENABLED=false
QUANT_LLM_API_KEY=
# Legacy Quant heartbeat flag is unused; Edge EA heartbeat is opt-in per exported EA.

# Edge Radar: private durable storage and bounded off-thread snapshot computation.
EDGE_DATA_DIR=.edge-data
EDGE_GUEST_TIMEZONE=America/Los_Angeles
EDGE_SNAPSHOT_WORKERS=2
EDGE_SNAPSHOT_TIMEOUT_MS=180000
# Server-only FRED API key for VIXCLS point-in-time vintages.
EDGE_FRED_API_KEY=
# Mail is disabled by default. The runner additionally requires --send-opted-in-email.
EDGE_EMAIL_SEND_ENABLED=false
MAILGUN_API_KEY=
EDGE_MAILGUN_DOMAIN=
EDGE_MAIL_FROM=
EDGE_MAILGUN_REGION=US
# Supply a securely generated random secret of at least 32 characters; never commit it.
EDGE_UNSUBSCRIBE_SECRET=
EDGE_PUBLIC_ORIGIN=https://fynxfinanceworld.com
# Edge MT5 heartbeat is enabled explicitly per EA via Profile token and EA inputs.

# My Accounts: local integration adapter. Production backend is still to be identified.
# Use Node 22.13+ or Node 24. The private parent directory must have mode 0700.
ACCOUNTS_DB_PATH=.accounts-data/accounts.sqlite
ACCOUNTS_FIREBASE_PROJECT_ID=
ACCOUNTS_ALLOWED_ORIGINS=https://fynxfinanceworld.com,https://www.fynxfinanceworld.com,http://127.0.0.1:4174,http://localhost:4174
# Default: __Host-fynx_accounts in production, fynx_accounts_dev locally.
# Firebase Hosting forwards only __session; set explicitly if that is the chosen proxy.
ACCOUNTS_SESSION_COOKIE=
# GCP Cloud KMS symmetric key resource, using workload identity/ADC. Never a browser key.
ACCOUNTS_KMS_KEY_NAME=
# Local-only envelope key. Generate 32 random bytes as base64 into ignored env storage.
# Local key mode is refused when NODE_ENV=production.
ACCOUNTS_ALLOW_LOCAL_KEY=false
ACCOUNTS_LOCAL_KEK=
ACCOUNTS_JOB_TIMEOUT_MS=300000
ACCOUNTS_MAX_ACCOUNTS=20
ACCOUNTS_FREE_CONNECTION_LIMIT=1
# All cloud connectors remain off until provider/region/terms and real acceptance are checked.
ACCOUNTS_MT4_ENABLED=false
ACCOUNTS_MT5_ENABLED=false
ACCOUNTS_METAAPI_TOKEN=
ACCOUNTS_METAAPI_REGION=new-york
ACCOUNTS_BINANCE_ENABLED=false
ACCOUNTS_BYBIT_ENABLED=false
ACCOUNTS_PROVIDER_REQUESTS_PER_MINUTE=40
ACCOUNTS_PROVIDER_TIMEOUT_MS=10000
ACCOUNTS_PROVIDER_HISTORY_MAX_PAGES=20
# Comma-separated firm IDs plus recorded permission evidence. Verified rules are not access approval.
ACCOUNTS_APPROVED_PROP_FIRMS=
# JSON object: firm ID -> {sourceUrl,checkedAt}. Leave empty until written permission is confirmed.
ACCOUNTS_PROP_TERMS_PROOFS_JSON={}
# Alerts require explicit user opt-in; deletion receipts are transactional.
# This server-level switch must also be on. No mail is sent by the local QA harness.
ACCOUNTS_EMAIL_SEND_ENABLED=false
# Optional overrides; otherwise the existing EDGE_MAILGUN_DOMAIN/EDGE_MAIL_FROM are used.
ACCOUNTS_MAILGUN_DOMAIN=
ACCOUNTS_MAIL_FROM=
