rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.email_verified == true && request.auth.token.email in ["ha6876122@gmail.com", "fynxteam5@gmail.com"])
      );
    }
    function verifiedForPayout(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.kycStatus == "verified";
    }
    function kycFields() {
      return [
        "kycStatus",
        "kycProvider",
        "kycSessionId",
        "kycSubmittedAt",
        "kycVerifiedAt",
        "kycRejectionReason"
      ];
    }
    function userKycFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(kycFields());
    }
    function userCreateDoesNotSelfVerify() {
      return !(request.resource.data.keys().hasAny(kycFields()))
        || request.resource.data.kycStatus == "not_started";
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && userCreateDoesNotSelfVerify();
      allow update: if isAdmin() || (isOwner(userId) && userKycFieldsUnchanged());

      // Website-owned records; other product collections keep their existing rules.
      match /account/{documentId} {
        allow read, write: if isOwner(userId) && documentId in ['profile', 'preferences', 'notificationPreferences', 'security'];
      }
      match /trades/{tradeId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.symbol is string
          && request.resource.data.pl is number;
      }
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
      match /sessions/{websiteSessionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.sessionId == websiteSessionId
          && request.resource.data.keys().hasOnly(['sessionId','userAgent','platform','language','timezone','status','lastActiveAt','createdAt','updatedAt','revokedAt']);
      }
      match /security/{documentId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && documentId == "settings"
          && request.resource.data.keys().hasOnly([
            "twoFactorEnabled",
            "twoFactorSecret",
            "loginAlertsEnabled",
            "backupCodesGeneratedAt",
            "backupCodeHashes",
            "activeSessions",
            "lastSecurityUpdate",
            "createdAt"
          ])
          && request.resource.data.twoFactorEnabled is bool
          && request.resource.data.loginAlertsEnabled is bool;
        allow delete: if false;
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.keys().hasOnly(["userId", "device", "browser", "ip", "location", "createdAt", "lastActive", "isCurrent"]);
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /securityEvents/{eventId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isAdmin();
      }

      // Private FYNX Builder projects. A project cannot be made public from the client.
      // Ordinary users: owner only. The pre-existing admin wildcard at the bottom of this file still matches every path, including these.
      function builderVersion(version) {
        return version is map
          && version.keys().hasOnly(['version', 'savedAt', 'main'])
          && version.version is int
          && version.version > 0
          && version.version < 10000
          && version.savedAt is number
          && version.main is string
          && version.main.size() > 0
          && version.main.size() <= 48000;
      }
      function builderVersions(versions) {
        return versions is list
          && versions.size() <= 5
          && (versions.size() < 1 || builderVersion(versions[0]))
          && (versions.size() < 2 || builderVersion(versions[1]))
          && (versions.size() < 3 || builderVersion(versions[2]))
          && (versions.size() < 4 || builderVersion(versions[3]))
          && (versions.size() < 5 || builderVersion(versions[4]));
      }
      function builderWidget(widget) {
        return widget is map
          && widget.keys().hasOnly(['slot', 'projectId', 'name', 'version', 'enabled'])
          && widget.slot is string
          && widget.projectId is string
          && widget.slot == 'mine-' + widget.projectId
          && widget.projectId.matches('^p[a-z0-9]{8,24}$')
          && widget.name is string
          && widget.name.size() > 0
          && widget.name.size() <= 80
          && widget.version is int
          && widget.version > 0
          && widget.version < 10000
          && widget.enabled is bool;
      }
      function builderWidgets(widgets) {
        return widgets is list
          && widgets.size() <= 12
          && (widgets.size() < 1 || builderWidget(widgets[0]))
          && (widgets.size() < 2 || builderWidget(widgets[1]))
          && (widgets.size() < 3 || builderWidget(widgets[2]))
          && (widgets.size() < 4 || builderWidget(widgets[3]))
          && (widgets.size() < 5 || builderWidget(widgets[4]))
          && (widgets.size() < 6 || builderWidget(widgets[5]))
          && (widgets.size() < 7 || builderWidget(widgets[6]))
          && (widgets.size() < 8 || builderWidget(widgets[7]))
          && (widgets.size() < 9 || builderWidget(widgets[8]))
          && (widgets.size() < 10 || builderWidget(widgets[9]))
          && (widgets.size() < 11 || builderWidget(widgets[10]))
          && (widgets.size() < 12 || builderWidget(widgets[11]));
      }
      match /builderProjects/{projectId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && projectId.matches('^p[a-z0-9]{8,24}$')
          && request.resource.data.keys().hasOnly(['name', 'description', 'category', 'version', 'visibility', 'authorUid', 'main', 'updatedAt', 'versions'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.description is string
          && request.resource.data.description.size() >= 12
          && request.resource.data.description.size() <= 500
          && request.resource.data.category in ['stocks', 'forex', 'crypto', 'bonds', 'commodities', 'options', 'policy', 'news', 'research', 'macro', 'visualization', 'portfolio', 'education', 'risk', 'business']
          && request.resource.data.visibility == 'private'
          && request.resource.data.authorUid == userId
          && request.resource.data.main is string
          && request.resource.data.main.size() > 0
          && request.resource.data.main.size() <= 48000
          && request.resource.data.version is int
          && request.resource.data.version > 0
          && request.resource.data.version < 10000
          && request.resource.data.updatedAt is number
          && builderVersions(request.resource.data.versions);
        allow delete: if isOwner(userId);
      }
      match /builderInstalls/{documentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && documentId == 'current'
          && request.resource.data.keys().hasOnly(['widgets'])
          && builderWidgets(request.resource.data.widgets);
        allow delete: if false;
      }
    }

    match /kyc_profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /payouts/{payoutId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "requested"
        && verifiedForPayout(request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /challenges/{challengeId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /accounts/{accountId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /trades/{tradeId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /certificates/{certificateId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /public_certificates/{certificateId} {
      allow read: if true;
      allow write: if false;
    }

    match /tickets/{ticketId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "open";
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["messages", "status", "updatedAt"])
        && request.resource.data.status in ["open", "waiting", "closed"]
      );
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
