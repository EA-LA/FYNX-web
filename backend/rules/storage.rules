rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/profile/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }
    // Existing mobile chat/avatar paths need a separate compatibility review.
    // Exclude website users paths so this legacy rule cannot bypass ownership.
    match /{root}/{allPaths=**} {
      allow read, write: if request.auth != null && root != 'users';
    }
  }
}
