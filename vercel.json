{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "fn/market.js",
      "use": "@vercel/node"
    },
    {
      "src": "fn/preview.js",
      "use": "@vercel/node"
    },
    {
      "src": "fn/research.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/research-data.cjs",
          "backend/research-core.cjs"
        ]
      }
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
